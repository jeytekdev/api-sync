{
    "name": "jeytekdev/api-sync",
    "description": "Auto-sync Postman/Insomnia/Bruno collections from PHP source code (routes, docblocks, attributes)",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "nikic/php-parser": "^5.0",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/finder": "^6.4 || ^7.0",
        "symfony/yaml": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Jeytekdev\\ApiSync\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jeytekdev\\ApiSync\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/api-sync"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    }
}
